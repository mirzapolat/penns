<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PennsAppGroup</key>
	<string>$(APP_GROUP_IDENTIFIER)</string>
	<key>PennsCloudKitContainer</key>
	<string>$(CLOUDKIT_CONTAINER_IDENTIFIER)</string>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Add to Penns</string>
			</dict>
			<key>NSMessage</key>
			<string>addToNote</string>
			<key>NSPortName</key>
			<string>Penns</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
				<string>NSStringPboardType</string>
			</array>
			<key>NSRequiredContext</key>
			<dict/>
		</dict>
	</array>
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.mirzapolat.penns.note</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.mirzapolat.penns</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>penns</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
