# ── Swift Package Manager ────────────────────────────────────
.build/
.swiftpm/
Packages/*/.build/
Packages/*/.swiftpm/
# Package.resolved: committed for the app (reproducible builds),
# ignored inside the local library package.
Packages/*/Package.resolved

# ── CocoaPods / Carthage (not used, guard anyway) ────────────
Pods/
Carthage/Build/
Carthage/Checkouts/

